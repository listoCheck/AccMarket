
###

### 1️⃣ ЛОГИН → получаем access / refresh / userId
POST http://localhost:{{SPRING_PORT}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "{{USERNAME}}",
  "password": "{{PASSWORD}}"
}

> {%
    const data = response.body.body; // <- обращаемся к вложенному body
    client.global.set("ACCESS_TOKEN", data.accessToken);
    client.global.set("REFRESH_TOKEN", data.refreshToken);
    client.global.set("USER_ID", data.userId);
    client.global.set("JWT", "Bearer " + data.accessToken);

    console.log("ACCESS_TOKEN =", client.global.get("ACCESS_TOKEN"));
    console.log("REFRESH_TOKEN =", client.global.get("REFRESH_TOKEN"));
    console.log("JWT =", client.global.get("JWT"));
    console.log("USER_ID =", client.global.get("USER_ID"));
%}


###

### 2️⃣ ОБНОВЛЕНИЕ ACCESS ТОКЕНА
POST http://localhost:{{SPRING_PORT}}/api/v1/auth/update-token
Content-Type: application/json

{
  "username": "{{USERNAME}}",
  "token": "{{REFRESH_TOKEN}}"
}

> {%
    console.log(response);
    client.global.set("ACCESS_TOKEN", response.body.body.accessToken);
    client.global.set("JWT", "Bearer " + response.body.body.accessToken);
%}

###

### 3️⃣ СОЗДАНИЕ ОБЪЯВЛЕНИЯ
POST http://localhost:{{SPRING_PORT}}/api/v1/core/make-advertisement
Content-Type: application/json

{
  "username": "{{USERNAME}}",
  "token": "{{ACCESS_TOKEN}}",
  "title": "Тестовый аккаунт",
  "text": "Текст объявления пидор",
  "cost": 1000,
  "platform": "PC",
  "genre": "RPG",
  "gameLogin": "game_login",
  "gamePassword": "game_password",
  "advertisementId": null
}

> {%
    console.log(response);
    client.global.set("ADVERTISEMENT_ID", response.body.body.token);
%}

