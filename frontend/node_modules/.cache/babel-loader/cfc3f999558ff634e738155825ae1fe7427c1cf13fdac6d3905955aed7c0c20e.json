{"ast":null,"code":"import { ref, computed } from 'vue';\nimport { useAuthStore } from '../stores/auth';\nexport default {\n  name: 'BalanceModal',\n  props: {\n    insufficientFunds: {\n      type: Boolean,\n      \"default\": false\n    }\n  },\n  emits: ['close', 'topped-up'],\n  setup: function setup(props, _ref) {\n    var emit = _ref.emit;\n    var authStore = useAuthStore();\n    var amount = ref(100);\n    var balance = computed(function () {\n      return authStore.balance;\n    });\n    var handleTopUp = function handleTopUp() {\n      if (amount.value > 0) {\n        authStore.addBalance(amount.value);\n        emit('topped-up', amount.value);\n        emit('close');\n      }\n    };\n    return {\n      amount: amount,\n      balance: balance,\n      handleTopUp: handleTopUp\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","useAuthStore","name","props","insufficientFunds","type","Boolean","emits","setup","_ref","emit","authStore","amount","balance","handleTopUp","value","addBalance"],"sources":["C:\\Users\\abobus\\itmo\\learning\\is\\AccMarket\\frontend\\src\\components\\BalanceModal.vue"],"sourcesContent":["<template>\r\n  <div class=\"modal-overlay\" @click.self=\"$emit('close')\">\r\n    <div class=\"modal-content\">\r\n      <div class=\"modal-header\">\r\n        <h2>Пополнение баланса</h2>\r\n        <button @click=\"$emit('close')\" class=\"close-btn\">&times;</button>\r\n      </div>\r\n\r\n      <div class=\"modal-body\">\r\n        <div v-if=\"insufficientFunds\" class=\"warning-message\">\r\n          ⚠️ Недостаточно средств, пополните!\r\n        </div>\r\n\r\n        <div class=\"balance-info\">\r\n          <p>Текущий баланс:</p>\r\n          <p class=\"balance-amount\">{{ balance }} ₽</p>\r\n        </div>\r\n\r\n        <form @submit.prevent=\"handleTopUp\">\r\n          <div class=\"form-group\">\r\n            <label for=\"amount\">Сумма пополнения (₽)</label>\r\n            <input\r\n              id=\"amount\"\r\n              v-model.number=\"amount\"\r\n              type=\"number\"\r\n              min=\"1\"\r\n              step=\"1\"\r\n              required\r\n              placeholder=\"Введите сумму\"\r\n            />\r\n          </div>\r\n\r\n          <div class=\"quick-amounts\">\r\n            <button\r\n              v-for=\"quickAmount in [100, 500, 1000, 5000]\"\r\n              :key=\"quickAmount\"\r\n              type=\"button\"\r\n              @click=\"amount = quickAmount\"\r\n              class=\"quick-btn\"\r\n            >\r\n              {{ quickAmount }} ₽\r\n            </button>\r\n          </div>\r\n\r\n          <div class=\"form-actions\">\r\n            <button type=\"button\" @click=\"$emit('close')\" class=\"btn btn-secondary\">\r\n              Отмена\r\n            </button>\r\n            <button type=\"submit\" class=\"btn btn-primary\">\r\n              Пополнить\r\n            </button>\r\n          </div>\r\n        </form>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed } from 'vue'\r\nimport { useAuthStore } from '../stores/auth'\r\n\r\nexport default {\r\n  name: 'BalanceModal',\r\n  props: {\r\n    insufficientFunds: {\r\n      type: Boolean,\r\n      default: false\r\n    }\r\n  },\r\n  emits: ['close', 'topped-up'],\r\n  setup(props, { emit }) {\r\n    const authStore = useAuthStore()\r\n    const amount = ref(100)\r\n\r\n    const balance = computed(() => authStore.balance)\r\n\r\n    const handleTopUp = () => {\r\n      if (amount.value > 0) {\r\n        authStore.addBalance(amount.value)\r\n        emit('topped-up', amount.value)\r\n        emit('close')\r\n      }\r\n    }\r\n\r\n    return {\r\n      amount,\r\n      balance,\r\n      handleTopUp\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.modal-overlay {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  right: 0;\r\n  bottom: 0;\r\n  background: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  z-index: 1000;\r\n}\r\n\r\n.modal-content {\r\n  background: white;\r\n  border-radius: 8px;\r\n  width: 90%;\r\n  max-width: 500px;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);\r\n}\r\n\r\n.modal-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 20px;\r\n  border-bottom: 1px solid #e0e0e0;\r\n}\r\n\r\n.modal-header h2 {\r\n  margin: 0;\r\n  color: #333;\r\n}\r\n\r\n.close-btn {\r\n  background: none;\r\n  border: none;\r\n  font-size: 32px;\r\n  color: #999;\r\n  cursor: pointer;\r\n  padding: 0;\r\n  width: 32px;\r\n  height: 32px;\r\n  line-height: 1;\r\n}\r\n\r\n.close-btn:hover {\r\n  color: #333;\r\n}\r\n\r\n.modal-body {\r\n  padding: 20px;\r\n}\r\n\r\n.warning-message {\r\n  background: #fff3cd;\r\n  border: 1px solid #ffc107;\r\n  color: #856404;\r\n  padding: 15px;\r\n  border-radius: 4px;\r\n  margin-bottom: 20px;\r\n  font-weight: 500;\r\n}\r\n\r\n.balance-info {\r\n  text-align: center;\r\n  padding: 20px;\r\n  background: #f5f5f5;\r\n  border-radius: 8px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.balance-info p {\r\n  margin: 5px 0;\r\n  color: #666;\r\n}\r\n\r\n.balance-amount {\r\n  font-size: 32px;\r\n  font-weight: bold;\r\n  color: #4CAF50;\r\n  margin-top: 10px;\r\n}\r\n\r\n.form-group {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.form-group label {\r\n  display: block;\r\n  margin-bottom: 5px;\r\n  color: #555;\r\n  font-weight: 500;\r\n}\r\n\r\n.form-group input {\r\n  width: 100%;\r\n  padding: 12px;\r\n  border: 1px solid #ddd;\r\n  border-radius: 4px;\r\n  font-size: 16px;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.form-group input:focus {\r\n  outline: none;\r\n  border-color: #4CAF50;\r\n}\r\n\r\n.quick-amounts {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, 1fr);\r\n  gap: 10px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.quick-btn {\r\n  padding: 10px;\r\n  border: 1px solid #4CAF50;\r\n  background: white;\r\n  color: #4CAF50;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n  transition: all 0.3s;\r\n}\r\n\r\n.quick-btn:hover {\r\n  background: #4CAF50;\r\n  color: white;\r\n}\r\n\r\n.form-actions {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  gap: 10px;\r\n}\r\n\r\n.btn {\r\n  padding: 12px 24px;\r\n  border: none;\r\n  border-radius: 4px;\r\n  font-size: 14px;\r\n  cursor: pointer;\r\n  transition: background-color 0.3s;\r\n}\r\n\r\n.btn-primary {\r\n  background-color: #4CAF50;\r\n  color: white;\r\n}\r\n\r\n.btn-primary:hover {\r\n  background-color: #45a049;\r\n}\r\n\r\n.btn-secondary {\r\n  background-color: #757575;\r\n  color: white;\r\n}\r\n\r\n.btn-secondary:hover {\r\n  background-color: #616161;\r\n}\r\n</style>"],"mappings":"AA2DA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAI;AAClC,SAASC,YAAW,QAAS,gBAAe;AAE5C,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,KAAK,EAAE;IACLC,iBAAiB,EAAE;MACjBC,IAAI,EAAEC,OAAO;MACb,WAAS;IACX;EACF,CAAC;EACDC,KAAK,EAAE,CAAC,OAAO,EAAE,WAAW,CAAC;EAC7BC,KAAK,WAALA,KAAKA,CAACL,KAAK,EAAAM,IAAA,EAAY;IAAA,IAARC,IAAG,GAAAD,IAAA,CAAHC,IAAG;IAChB,IAAMC,SAAQ,GAAIV,YAAY,CAAC;IAC/B,IAAMW,MAAK,GAAIb,GAAG,CAAC,GAAG;IAEtB,IAAMc,OAAM,GAAIb,QAAQ,CAAC;MAAA,OAAMW,SAAS,CAACE,OAAO;IAAA;IAEhD,IAAMC,WAAU,GAAI,SAAdA,WAAUA,CAAA,EAAU;MACxB,IAAIF,MAAM,CAACG,KAAI,GAAI,CAAC,EAAE;QACpBJ,SAAS,CAACK,UAAU,CAACJ,MAAM,CAACG,KAAK;QACjCL,IAAI,CAAC,WAAW,EAAEE,MAAM,CAACG,KAAK;QAC9BL,IAAI,CAAC,OAAO;MACd;IACF;IAEA,OAAO;MACLE,MAAM,EAANA,MAAM;MACNC,OAAO,EAAPA,OAAO;MACPC,WAAU,EAAVA;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}