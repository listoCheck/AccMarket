           if (response.data) {\n                advertisements.value = Array.isArray(response.data) ? response.data : [response.data];\n              }\n              _context2.n = 4;\n              break;\n            case 3:\n              _context2.p = 3;\n              _t2 = _context2.v;\n              adsError.value = ((_error$response2 = _t2.response) === null || _error$response2 === void 0 || (_error$response2 = _error$response2.data) === null || _error$response2 === void 0 ? void 0 : _error$response2.message) || 'Ошибка загрузки объявлений';\n            case 4:\n              _context2.p = 4;\n              loadingAds.value = false;\n              return _context2.f(4);\n            case 5:\n              return _context2.a(2);\n          }\n        }, _callee2, null, [[1, 3, 4, 5]]);\n      }));\n      return function loadAdvertisements() {\n        return _ref2.apply(this, arguments);\n      };\n    }();\n    var openRoleModal = function openRoleModal(user) {\n      selectedUser.value = user;\n      roleInput.value = user.roles ? user.roles.join(', ') : '';\n      showRoleModal.value = true;\n    };\n    var closeRoleModal = function closeRoleModal() {\n      showRoleModal.value = false;\n      selectedUser.value = null;\n      roleInput.value = '';\n    };\n    var updateUserRoles = /*#__PURE__*/function () {\n      var _ref3 = _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee3() {\n        var roles, _error$response3, _t3;\n        return _regenerator().w(function (_context3) {\n          while (1) switch (_context3.p = _context3.n) {\n            case 0:\n              if (selectedUser.value) {\n                _context3.n = 1;\n                break;\n              }\n              return _context3.a(2);\n            case 1:\n              loadingAction.value = true;\n              _context3.p = 2;\n              roles = roleInput.value.split(',').map(function (r) {\n                return r.trim();\n              }).filter(function (r) {\n                return r;\n              });\n              _context3.n = 3;\n              return api.admin.updateUserRoles({\n                username: authStore.username,\n                token: authStore.accessToken,\n                targetUsername: selectedUser.value.username,\n                roles: roles\n              });\n            case 3:\n              closeRoleModal();\n              loadUsers();\n              showActionMessage('Роли успешно обновлены', 'success');\n              _context3.n = 5;\n              break;\n            case 4:\n              _context3.p = 4;\n              _t3 = _context3.v;\n              showActionMessage(((_error$response3 = _t3.response) === null || _error$response3 === void 0 || (_error$response3 = _error$response3.data) === null || _error$response3 === void 0 ? void 0 : _error$response3.message) || 'Ошибка обновления ролей', 'error');\n            case 5:\n              _context3.p = 5;\n              loadingAction.value = false;\n              return _context3.f(5);\n            case 6:\n              return _context3.a(2);\n          }\n        }, _callee3, null, [[2, 4, 5, 6]]);\n      }));\n      return function updateUserRoles() {\n        return _ref3.apply(this, arguments);\n      };\n    }();\n    var assignAdmin = /*#__PURE__*/function () {\n      var _ref4 = _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee4() {\n        var _error$response4, _t4;\n        return _regenerator().w(function (_context4) {\n          while (1) switch (_context4.p = _context4.n) {\n            case 0:\n              loadingAction.value = true;\n              _context4.p = 1;\n              _context4.n = 2;\n              return api.admin.assignAdmin({\n                username: adminForm.value.username,\n                token: authStore.accessToken,\n                adminSecret: adminForm.value.adminSecret,\n                email: adminForm.value.email\n              });\n            case 2:\n              adminForm.value = {\n                username: '',\n                email: '',\n                adminSecret: ''\n              };\n              showActionMessage('Администратор успешно назначен', 'success');\n              loadUsers();\n              _context4.n = 4;\n              break;\n            case 3:\n              _context4.p = 3;\n              _t4 = _context4.v;\n              showActionMessage(((_error$response4 = _t4.response) === null || _error$response4 === void 0 || (_error$response4 = _error$response4.data) === null || _error$response4 === void 0 ? void 0 : _error$response4.message) || 'Ошибка назначения администратора', 'error');\n            case 4:\n              _context4.p = 4;\n              loadingAction.value = false;\n              return _context4.f(4);\n            case 5:\n              return _context4.a(2);\n          }\n        }, _callee4, null, [[1, 3, 4, 5]]);\n      }));\n      return function assignAdmin() {\n        return _ref4.apply(this, arguments);\n      };\n    }();\n    var assignModerator = /*#__PURE__*/function () {\n      var _ref5 = _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee5() {\n        var _error$response5, _t5;\n        return _regenerator().w(function (_context5) {\n          while (1) switch (_context5.p = _context5.n) {\n            case 0:\n              loadingAction.value = true;\n              _context5.p = 1;\n              _context5.n = 2;\n              return api.admin.assignModerator({\n                adminId: authStore.username,\n                adminToken: authStore.accessToken,\n                moderatorId: moderatorForm.value.moderatorId\n              });\n            case 2:\n              moderatorForm.value = {\n                moderatorId: ''\n              };\n              showActionMessage('Модератор успешно назначен', 'success');\n              loadUsers();\n              _context5.n = 4;\n              break;\n            case 3:\n              _context5.p = 3;\n              _t5 = _context5.v;\n              showActionMessage(((_error$response5 = _t5.response) === null || _error$response5 === void 0 || (_error$response5 = _error$response5.data) === null || _error$response5 === void 0 ? void 0 : _error$response5.message) || 'Ошибка назначения модератора', 'error');\n            case 4:\n              _context5.p = 4;\n              loadingAction.value = false;\n              return _context5.f(4);\n            case 5:\n              return _context5.a(2);\n          }\n        }, _callee5, null, [[1, 3, 4, 5]]);\n      }));\n      return function assignModerator() {\n        return _ref5.apply(this, arguments);\n      };\n    }();\n    var showActionMessage = function showActionMessage(message, type) {\n      actionMessage.value = message;\n      actionMessageType.value = type;\n      setTimeout(function () {\n        actionMessage.value = '';\n      }, 5000);\n    };\n    onMounted(function () {\n      loadUsers();\n    });\n    return {\n      activeTab: activeTab,\n      users: users,\n      advertisements: advertisements,\n      loadingUsers: loadingUsers,\n      loadingAds: loadingAds,\n      loadingAction: loadingAction,\n      usersError: usersError,\n      adsError: adsError,\n      adUserId: adUserId,\n      showRoleModal: showRoleModal,\n      selectedUser: selectedUser,\n      roleInput: roleInput,\n      adminForm: adminForm,\n      moderatorForm: moderatorForm,\n      actionMessage: actionMessage,\n      actionMessageType: actionMessageType,\n      loadUsers: loadUsers,\n      loadAdvertisements: loadAdvertisements,\n      openRoleModal: openRoleModal,\n      closeRoleModal: closeRoleModal,\n      updateUserRoles: updateUserRoles,\n      assignAdmin: assignAdmin,\n      assignModerator: assignModerator\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","useAuthStore","api","name","setup","authStore","activeTab","users","advertisements","loadingUsers","loadingAds","loadingAction","usersError","adsError","adUserId","showRoleModal","selectedUser","roleInput","adminForm","username","email","adminSecret","moderatorForm","moderatorId","actionMessage","actionMessageType","loadUsers","_ref","_asyncToGenerator","_regenerator","m","_callee","response","_error$response","_t","w","_context","p","n","value","admin","getAllUsers","accessToken","v","data","code","body","message","f","a","apply","arguments","loadAdvertisements","_ref2","_callee2","params","_error$response2","_t2","_context2","userId","getAdvertisements","Array","isArray","openRoleModal","user","roles","join","closeRoleModal","updateUserRoles","_ref3","_callee3","_error$response3","_t3","_context3","split","map","r","trim","filter","token","targetUsername","showActionMessage","assignAdmin","_ref4","_callee4","_error$response4","_t4","_context4","assignModerator","_ref5","_callee5","_error$response5","_t5","_context5","adminId","adminToken","type","setTimeout"],"sources":["C:\\Users\\abobus\\itmo\\learning\\is\\AccMarket\\frontend\\src\\components\\AdminPanel.vue"],"sourcesContent":["<template>\r\n  <div class=\"admin-panel\">\r\n    <h2>Панель администратора</h2>\r\n    \r\n    <div class=\"admin-tabs\">\r\n      <button\r\n        :class=\"['tab-btn', { active: activeTab === 'users' }]\"\r\n        @click=\"activeTab = 'users'\"\r\n      >\r\n        Пользователи\r\n      </button>\r\n      <button\r\n        :class=\"['tab-btn', { active: activeTab === 'ads' }]\"\r\n        @click=\"activeTab = 'ads'\"\r\n      >\r\n        Объявления\r\n      </button>\r\n      <button\r\n        :class=\"['tab-btn', { active: activeTab === 'roles' }]\"\r\n        @click=\"activeTab = 'roles'\"\r\n      >\r\n        Управление ролями\r\n      </button>\r\n    </div>\r\n\r\n    <!-- Users Tab -->\r\n    <div v-if=\"activeTab === 'users'\" class=\"tab-content\">\r\n      <div class=\"section-header\">\r\n        <h3>Все пользователи</h3>\r\n        <button @click=\"loadUsers\" class=\"btn btn-primary btn-small\">\r\n          Обновить\r\n        </button>\r\n      </div>\r\n\r\n      <div v-if=\"loadingUsers\" class=\"loading\">Загрузка пользователей...</div>\r\n      <div v-else-if=\"usersError\" class=\"error-message\">{{ usersError }}</div>\r\n      <div v-else-if=\"users.length === 0\" class=\"no-data\">Пользователи не найдены</div>\r\n      \r\n      <div v-else class=\"users-table\">\r\n        <table>\r\n          <thead>\r\n            <tr>\r\n              <th>ID</th>\r\n              <th>Имя пользователя</th>\r\n              <th>Email</th>\r\n              <th>Роли</th>\r\n              <th>Действия</th>\r\n            </tr>\r\n          </thead>\r\n          <tbody>\r\n            <tr v-for=\"user in users\" :key=\"user.id\">\r\n              <td>{{ user.id }}</td>\r\n              <td>{{ user.username }}</td>\r\n              <td>{{ user.email }}</td>\r\n              <td>\r\n                <span v-for=\"role in user.roles\" :key=\"role\" class=\"role-badge\">\r\n                  {{ role }}\r\n                </span>\r\n              </td>\r\n              <td>\r\n                <button\r\n                  @click=\"openRoleModal(user)\"\r\n                  class=\"btn btn-small btn-secondary\"\r\n                >\r\n                  Изменить роли\r\n                </button>\r\n              </td>\r\n            </tr>\r\n          </tbody>\r\n        </table>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Advertisements Tab -->\r\n    <div v-if=\"activeTab === 'ads'\" class=\"tab-content\">\r\n      <div class=\"section-header\">\r\n        <h3>Все объявления</h3>\r\n        <div class=\"filters\">\r\n          <input\r\n            v-model=\"adUserId\"\r\n            type=\"text\"\r\n            placeholder=\"ID пользователя\"\r\n            class=\"filter-input\"\r\n          />\r\n          <button @click=\"loadAdvertisements\" class=\"btn btn-primary btn-small\">\r\n            Загрузить\r\n          </button>\r\n        </div>\r\n      </div>\r\n\r\n      <div v-if=\"loadingAds\" class=\"loading\">Загрузка объявлений...</div>\r\n      <div v-else-if=\"adsError\" class=\"error-message\">{{ adsError }}</div>\r\n      <div v-else-if=\"advertisements.length === 0\" class=\"no-data\">\r\n        Объявления не найдены\r\n      </div>\r\n      \r\n      <div v-else class=\"ads-grid\">\r\n        <div v-for=\"ad in advertisements\" :key=\"ad.id\" class=\"ad-card\">\r\n          <div class=\"ad-header\">\r\n            <h4>{{ ad.title }}</h4>\r\n            <span class=\"ad-price\">{{ ad.cost }} ₽</span>\r\n          </div>\r\n          <p class=\"ad-description\">{{ ad.text }}</p>\r\n          <div class=\"ad-meta\">\r\n            <span class=\"ad-info\">ID: {{ ad.id }}</span>\r\n            <span class=\"ad-info\">User ID: {{ ad.userId }}</span>\r\n          </div>\r\n          <div v-if=\"ad.platform || ad.genre\" class=\"ad-tags\">\r\n            <span v-if=\"ad.platform\" class=\"tag\">{{ ad.platform }}</span>\r\n            <span v-if=\"ad.genre\" class=\"tag\">{{ ad.genre }}</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Roles Management Tab -->\r\n    <div v-if=\"activeTab === 'roles'\" class=\"tab-content\">\r\n      <div class=\"roles-section\">\r\n        <h3>Назначить администратора</h3>\r\n        <form @submit.prevent=\"assignAdmin\" class=\"role-form\">\r\n          <div class=\"form-row\">\r\n            <div class=\"form-group\">\r\n              <label>Имя пользователя</label>\r\n              <input v-model=\"adminForm.username\" type=\"text\" required />\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <label>Email</label>\r\n              <input v-model=\"adminForm.email\" type=\"email\" required />\r\n            </div>\r\n          </div>\r\n          <div class=\"form-group\">\r\n            <label>Секретный ключ администратора</label>\r\n            <input v-model=\"adminForm.adminSecret\" type=\"password\" required />\r\n          </div>\r\n          <button type=\"submit\" class=\"btn btn-primary\" :disabled=\"loadingAction\">\r\n            {{ loadingAction ? 'Назначение...' : 'Назначить администратора' }}\r\n          </button>\r\n        </form>\r\n      </div>\r\n\r\n      <div class=\"roles-section\">\r\n        <h3>Назначить модератора</h3>\r\n        <form @submit.prevent=\"assignModerator\" class=\"role-form\">\r\n          <div class=\"form-group\">\r\n            <label>ID модератора (UUID)</label>\r\n            <input v-model=\"moderatorForm.moderatorId\" type=\"text\" required />\r\n          </div>\r\n          <button type=\"submit\" class=\"btn btn-primary\" :disabled=\"loadingAction\">\r\n            {{ loadingAction ? 'Назначение...' : 'Назначить модератора' }}\r\n          </button>\r\n        </form>\r\n      </div>\r\n\r\n      <div v-if=\"actionMessage\" :class=\"['action-message', actionMessageType]\">\r\n        {{ actionMessage }}\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Role Edit Modal -->\r\n    <div v-if=\"showRoleModal\" class=\"modal-overlay\" @click.self=\"closeRoleModal\">\r\n      <div class=\"modal-content\">\r\n        <div class=\"modal-header\">\r\n          <h3>Изменить роли: {{ selectedUser?.username }}</h3>\r\n          <button @click=\"closeRoleModal\" class=\"close-btn\">&times;</button>\r\n        </div>\r\n        <form @submit.prevent=\"updateUserRoles\">\r\n          <div class=\"form-group\">\r\n            <label>Роли (через запятую)</label>\r\n            <input\r\n              v-model=\"roleInput\"\r\n              type=\"text\"\r\n              placeholder=\"ROLE_USER, ROLE_ADMIN, ROLE_MODERATOR\"\r\n            />\r\n            <small>Доступные роли: ROLE_USER, ROLE_ADMIN, ROLE_MODERATOR</small>\r\n          </div>\r\n          <div class=\"form-actions\">\r\n            <button type=\"button\" @click=\"closeRoleModal\" class=\"btn btn-secondary\">\r\n              Отмена\r\n            </button>\r\n            <button type=\"submit\" class=\"btn btn-primary\" :disabled=\"loadingAction\">\r\n              {{ loadingAction ? 'Сохранение...' : 'Сохранить' }}\r\n            </button>\r\n          </div>\r\n        </form>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from 'vue'\r\nimport { useAuthStore } from '../stores/auth'\r\nimport api from '../services/api'\r\n\r\nexport default {\r\n  name: 'AdminPanel',\r\n  setup() {\r\n    const authStore = useAuthStore()\r\n    \r\n    const activeTab = ref('users')\r\n    const users = ref([])\r\n    const advertisements = ref([])\r\n    const loadingUsers = ref(false)\r\n    const loadingAds = ref(false)\r\n    const loadingAction = ref(false)\r\n    const usersError = ref('')\r\n    const adsError = ref('')\r\n    const adUserId = ref('')\r\n    \r\n    const showRoleModal = ref(false)\r\n    const selectedUser = ref(null)\r\n    const roleInput = ref('')\r\n    \r\n    const adminForm = ref({\r\n      username: '',\r\n      email: '',\r\n      adminSecret: ''\r\n    })\r\n    \r\n    const moderatorForm = ref({\r\n      moderatorId: ''\r\n    })\r\n    \r\n    const actionMessage = ref('')\r\n    const actionMessageType = ref('success')\r\n\r\n    const loadUsers = async () => {\r\n      loadingUsers.value = true\r\n      usersError.value = ''\r\n      \r\n      try {\r\n        const response = await api.admin.getAllUsers(\r\n          authStore.username,\r\n          authStore.accessToken\r\n        )\r\n        \r\n        if (response.data.code === 200 && response.data.body) {\r\n          users.value = response.data.body\r\n        } else {\r\n          usersError.value = response.data.message || 'Ошибка загрузки пользователей'\r\n        }\r\n      } catch (error) {\r\n        usersError.value = error.response?.data?.message || 'Ошибка загрузки пользователей'\r\n      } finally {\r\n        loadingUsers.value = false\r\n      }\r\n    }\r\n\r\n    const loadAdvertisements = async () => {\r\n      loadingAds.value = true\r\n      adsError.value = ''\r\n      \r\n      try {\r\n        const params = {}\r\n        if (adUserId.value) {\r\n          params.userId = adUserId.value\r\n        }\r\n        \r\n        const response = await api.admin.getAdvertisements(params)\r\n        \r\n        if (response.data) {\r\n          advertisements.value = Array.isArray(response.data) \r\n            ? response.data \r\n            : [response.data]\r\n        }\r\n      } catch (error) {\r\n        adsError.value = error.response?.data?.message || 'Ошибка загрузки объявлений'\r\n      } finally {\r\n        loadingAds.value = false\r\n      }\r\n    }\r\n\r\n    const openRoleModal = (user) => {\r\n      selectedUser.value = user\r\n      roleInput.value = user.roles ? user.roles.join(', ') : ''\r\n      showRoleModal.value = true\r\n    }\r\n\r\n    const closeRoleModal = () => {\r\n      showRoleModal.value = false\r\n      selectedUser.value = null\r\n      roleInput.value = ''\r\n    }\r\n\r\n    const updateUserRoles = async () => {\r\n      if (!selectedUser.value) return\r\n      \r\n      loadingAction.value = true\r\n      \r\n      try {\r\n        const roles = roleInput.value\r\n          .split(',')\r\n          .map(r => r.trim())\r\n          .filter(r => r)\r\n        \r\n        await api.admin.updateUserRoles({\r\n          username: authStore.username,\r\n          token: authStore.accessToken,\r\n          targetUsername: selectedUser.value.username,\r\n          roles\r\n        })\r\n        \r\n        closeRoleModal()\r\n        loadUsers()\r\n        showActionMessage('Роли успешно обновлены', 'success')\r\n      } catch (error) {\r\n        showActionMessage(\r\n          error.response?.data?.message || 'Ошибка обновления ролей',\r\n          'error'\r\n        )\r\n      } finally {\r\n        loadingAction.value = false\r\n      }\r\n    }\r\n\r\n    const assignAdmin = async () => {\r\n      loadingAction.value = true\r\n      \r